{
  "schema_version": 1,
  "description": "Local Splatoon 3 battle analysis data registry. Paths are relative to the project root.",
  "matches": [
    {
      "id": "match_1",
      "video": "footages/match_1.mp4",
      "purpose": ["analysis_baseline"],
      "notes": "Primary restored YOLO/OCR/weapon baseline.",
      "analysis_windows": [
        {
          "id": "match_1_10_150",
          "start_seconds": 10.0,
          "stop_seconds": 150.0,
          "sample_fps": 5.0,
          "device": "mps"
        }
      ]
    },
    {
      "id": "match_9",
      "video": "footages/match_9.mp4",
      "purpose": ["heatmap_baseline", "color_calibration"],
      "notes": "Yellow vs blue heatmap baseline.",
      "heatmap": {
        "id": "heatmap_match9",
        "config": "src/heatmap/config_match9.yaml",
        "output_dir": "outputs/heatmap_match9",
        "report": "outputs/heatmap_match9/report.md",
        "color_report": "outputs/heatmap_match9/color_calibration_report.csv",
        "player_tracks": "outputs/heatmap_match9/player_tracks.csv",
        "player_track_gaps": "outputs/heatmap_match9/player_track_gaps.csv",
        "player_routes_dir": "outputs/heatmap_match9/player_routes",
        "teams": ["yellow", "blue"],
        "start_seconds": 20.0,
        "stop_seconds": 160.0,
        "sample_fps": 1.0,
        "quality_gates": {
          "min_track_rows": 1000,
          "max_gap_ratio": 0.2,
          "max_jump_reset_ratio": 0.2,
          "min_route_images": 8
        }
      }
    },
